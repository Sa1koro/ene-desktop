{
  "name": "ene-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "ENE desktop companion: a Tauri desktop-pet body for the OpenClaw ENE agent",
  "type": "module",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "start:browser": "node scripts/launch.mjs browser",
    "build:exe": "node scripts/launch.mjs build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "bridge": "node bridge/ene-bridge.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "vmd:demo": "node scripts/make-test-vmd.mjs"
  },
  "dependencies": {
    "@moeru/three-mmd": "0.2.0-beta.2",
    "@moeru/three-mmd-physics-ammo": "0.2.0-beta.2",
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@tauri-apps/api": "^2.12.3",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
